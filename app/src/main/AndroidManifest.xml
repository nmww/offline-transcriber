<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️ 隐私红线：本应用【不申请 INTERNET 权限】，全程离线。
     任何新增依赖若引入联网能力（如在线 SDK、埋点库）均违反产品规格，禁止添加。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 旧版外部存储读取（Android 9 及以下；经 SAF 选择文件通常无需此权限） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 明确声明确无联网需求，阻止第三方库偷偷带入 -->
    <uses-permission android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineTranscriber"
        android:largeHeap="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OfflineTranscriber"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="user">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".pipeline.TranscribeService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>
</manifest>
