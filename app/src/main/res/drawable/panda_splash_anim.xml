<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/panda_splash">
    <target
        android:name="head"
        android:animation="@animator/ot_stroke_head" />
    <target
        android:name="ear_l"
        android:animation="@animator/ot_stroke_ear_l" />
    <target
        android:name="ear_r"
        android:animation="@animator/ot_stroke_ear_r" />
    <target
        android:name="eye_ring_l"
        android:animation="@animator/ot_stroke_eye_ring_l" />
    <target
        android:name="eye_ring_r"
        android:animation="@animator/ot_stroke_eye_ring_r" />
    <target
        android:name="pupil_l"
        android:animation="@animator/ot_fill_pupil_l" />
    <target
        android:name="pupil_r"
        android:animation="@animator/ot_fill_pupil_r" />
    <target
        android:name="nose"
        android:animation="@animator/ot_fill_nose" />
    <target
        android:name="mouth"
        android:animation="@animator/ot_stroke_mouth" />
</animated-vector>
